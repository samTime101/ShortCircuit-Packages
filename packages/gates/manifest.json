{
  "schema": "shortcircuit.package/v1",
  "name": "@shortcircuit/gates",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "recommendedAutoImport": true,
  "description": "Basic logic gates built from NAND.",
  "exports": [
    {
      "kind": "macro",
      "name": "NOT",
      "source": "macros/not/macro.lf",
      "group": "Basic Logic Gates",
      "summary": "Bitwise inversion. Expands to NAND(x, x).",
      "docs": "docs/not.md",
      "examples": [
        "y = NOT(a)"
      ]
    },
    {
      "kind": "macro",
      "name": "AND",
      "source": "macros/and/macro.lf",
      "group": "Basic Logic Gates",
      "summary": "Bitwise AND. Expands to NOT(NAND(a, b, ...)).",
      "docs": "docs/and.md",
      "examples": [
        "y = AND(a, b)"
      ]
    },
    {
      "kind": "macro",
      "name": "OR",
      "source": "macros/or/macro.lf",
      "group": "Basic Logic Gates",
      "summary": "Bitwise OR. Folds OR2 across the inputs.",
      "docs": "docs/or.md",
      "examples": [
        "y = OR(a, b)"
      ]
    },
    {
      "kind": "macro",
      "name": "BUFFER",
      "source": "macros/buffer/macro.lf",
      "group": "Basic Logic Gates",
      "summary": "Identity buffer. Expands to NOT(NOT(x)).",
      "docs": "docs/buffer.md",
      "examples": [
        "y = BUFFER(a)"
      ]
    },
    {
      "kind": "macro",
      "name": "OR2",
      "source": "macros/or2/macro.lf",
      "internal": true,
      "group": "Basic Logic Gates",
      "summary": "Internal binary OR helper."
    },
    {
      "kind": "macro",
      "name": "NOR",
      "source": "macros/nor/macro.lf",
      "group": "Universal Logic Gates",
      "summary": "Bitwise NOR. Expands to NOT(OR(a, b, ...)).",
      "docs": "docs/nor.md",
      "examples": [
        "y = NOR(a, b)"
      ]
    },
    {
      "kind": "macro",
      "name": "XOR2",
      "source": "macros/xor2/macro.lf",
      "internal": true,
      "group": "Exclusive Gates",
      "summary": "Internal binary XOR helper."
    },
    {
      "kind": "macro",
      "name": "XOR",
      "source": "macros/xor/macro.lf",
      "group": "Exclusive Gates",
      "summary": "Bitwise XOR. Folds XOR2 across the inputs.",
      "docs": "docs/xor.md",
      "examples": [
        "y = XOR(a, b)"
      ]
    },
    {
      "kind": "macro",
      "name": "XNOR",
      "source": "macros/xnor/macro.lf",
      "group": "Exclusive Gates",
      "summary": "Bitwise XNOR. Expands to NOT(XOR(a, b, ...)).",
      "docs": "docs/xnor.md",
      "examples": [
        "y = XNOR(a, b)"
      ]
    }
  ]
}
