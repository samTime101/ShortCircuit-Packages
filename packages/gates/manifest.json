{
  "schema": "shortcircuit.package/v1",
  "name": "@shortcircuit/gates",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "recommendedAutoImport": true,
  "description": "Basic logic gates built from NAND.",
  "exports": [
    {
      "kind": "macro",
      "name": "NOT",
      "args": ["x"],
      "minArgs": 1,
      "maxArgs": 1,
      "signature": "NOT(x)",
      "group": "Basic Logic Gates",
      "summary": "Bitwise inversion. Expands to NAND(x, x).",
      "body": "NAND(x, x)",
      "docs": "docs/not.md",
      "examples": ["y = NOT(a)"]
    },
    {
      "kind": "macro",
      "name": "AND",
      "args": ["a", "b"],
      "minArgs": 2,
      "maxArgs": null,
      "variadic": true,
      "signature": "AND(a, b, ...)",
      "group": "Basic Logic Gates",
      "summary": "Bitwise AND. Expands to NOT(NAND(a, b, ...)).",
      "body": "NOT(NAND(a, b, ...))",
      "docs": "docs/and.md",
      "examples": ["y = AND(a, b)"]
    },
    {
      "kind": "macro",
      "name": "OR",
      "args": ["a", "b"],
      "minArgs": 2,
      "maxArgs": null,
      "variadic": true,
      "signature": "OR(a, b, ...)",
      "group": "Basic Logic Gates",
      "summary": "Bitwise OR. Expands to NAND(NOT(a), NOT(b), ...).",
      "body": "NAND(NOT(a), NOT(b), ...)",
      "docs": "docs/or.md",
      "examples": ["y = OR(a, b)"]
    },
    {
      "kind": "macro",
      "name": "BUFFER",
      "args": ["x"],
      "minArgs": 1,
      "maxArgs": 1,
      "signature": "BUFFER(x)",
      "group": "Basic Logic Gates",
      "summary": "Identity buffer. Expands to NOT(NOT(x)).",
      "body": "NOT(NOT(x))",
      "docs": "docs/buffer.md",
      "examples": ["y = BUFFER(a)"]
    },
    {
      "kind": "macro",
      "name": "NOR",
      "args": ["a", "b"],
      "minArgs": 2,
      "maxArgs": null,
      "variadic": true,
      "signature": "NOR(a, b, ...)",
      "group": "Universal Logic Gates",
      "summary": "Bitwise NOR. Expands to NOT(OR(a, b, ...)).",
      "body": "NOT(OR(a, b, ...))",
      "docs": "docs/nor.md",
      "examples": ["y = NOR(a, b)"]
    },
    {
      "kind": "macro",
      "name": "XOR2",
      "internal": true,
      "args": ["a", "b"],
      "minArgs": 2,
      "maxArgs": 2,
      "signature": "XOR2(a, b)",
      "group": "Exclusive Gates",
      "summary": "Internal binary XOR helper.",
      "body": "NAND(NAND(a, NAND(a, b)), NAND(b, NAND(a, b)))"
    },
    {
      "kind": "macro",
      "name": "XOR",
      "args": ["a", "b"],
      "minArgs": 2,
      "maxArgs": null,
      "variadic": true,
      "fold": "XOR2",
      "signature": "XOR(a, b, ...)",
      "group": "Exclusive Gates",
      "summary": "Bitwise XOR. Folds XOR2 across the inputs.",
      "docs": "docs/xor.md",
      "examples": ["y = XOR(a, b)"]
    },
    {
      "kind": "macro",
      "name": "XNOR",
      "args": ["a", "b"],
      "minArgs": 2,
      "maxArgs": null,
      "variadic": true,
      "signature": "XNOR(a, b, ...)",
      "group": "Exclusive Gates",
      "summary": "Bitwise XNOR. Expands to NOT(XOR(a, b, ...)).",
      "body": "NOT(XOR(a, b, ...))",
      "docs": "docs/xnor.md",
      "examples": ["y = XNOR(a, b)"]
    }
  ]
}
