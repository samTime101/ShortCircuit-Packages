{
  "schema": "shortcircuit.package/v1",
  "name": "@shortcircuit/arithmetic",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "recommendedAutoImport": true,
  "description": "Small arithmetic circuits built from the gates package.",
  "dependencies": {
    "@shortcircuit/gates": "^0.1.0"
  },
  "exports": [
    {
      "kind": "circuit",
      "name": "HALF_ADDER",
      "group": "Arithmetic Circuits",
      "summary": "One-bit half adder: sum = XOR(a, b), carry = AND(a, b).",
      "source": "circuits/half-adder/circuit.lf",
      "docs": "circuits/half-adder/docs.md",
      "tests": "circuits/half-adder/test.lf",
      "ports": {
        "inputs": [
          { "name": "a", "width": 1 },
          { "name": "b", "width": 1 }
        ],
        "outputs": [
          { "name": "sum", "width": 1 },
          { "name": "carry", "width": 1 }
        ]
      }
    },
    {
      "kind": "circuit",
      "name": "FULL_ADDER",
      "group": "Arithmetic Circuits",
      "summary": "One-bit full adder built from two half adders and an OR gate.",
      "source": "circuits/full-adder/circuit.lf",
      "docs": "circuits/full-adder/docs.md",
      "tests": "circuits/full-adder/test.lf",
      "ports": {
        "inputs": [
          { "name": "a", "width": 1 },
          { "name": "b", "width": 1 },
          { "name": "carry_in", "width": 1 }
        ],
        "outputs": [
          { "name": "sum", "width": 1 },
          { "name": "carry_out", "width": 1 }
        ]
      }
    },
    {
      "kind": "circuit",
      "name": "ADD4",
      "group": "Arithmetic Circuits",
      "summary": "Four-bit ripple-carry adder with carry in and carry out.",
      "source": "circuits/add4/circuit.lf",
      "docs": "circuits/add4/docs.md",
      "tests": "circuits/add4/test.lf",
      "ports": {
        "inputs": [
          { "name": "a", "width": 4 },
          { "name": "b", "width": 4 },
          { "name": "carry_in", "width": 1 }
        ],
        "outputs": [
          { "name": "sum", "width": 4 },
          { "name": "carry_out", "width": 1 }
        ]
      }
    },
    {
      "kind": "circuit",
      "name": "ADD8",
      "group": "Arithmetic Circuits",
      "summary": "Eight-bit adder built from two chained ADD4 circuits.",
      "source": "circuits/add8/circuit.lf",
      "docs": "circuits/add8/docs.md",
      "tests": "circuits/add8/test.lf",
      "ports": {
        "inputs": [
          { "name": "a", "width": 8 },
          { "name": "b", "width": 8 },
          { "name": "carry_in", "width": 1 }
        ],
        "outputs": [
          { "name": "sum", "width": 8 },
          { "name": "carry_out", "width": 1 }
        ]
      }
    }
  ]
}
