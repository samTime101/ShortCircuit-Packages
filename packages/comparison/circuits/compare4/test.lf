CIRCUIT COMPARE4_TEST
  INPUT a : BUS(4)
  INPUT b : BUS(4)

  compared = COMPARE4(a, b)

  OUTPUT compared.eq
  OUTPUT compared.lt
  OUTPUT compared.gt
END

TEST COMPARE4_TEST
  CASE "equal values"
    INPUT a = 0101
    INPUT b = 0101
    EXPECT compared.eq = 1
    EXPECT compared.lt = 0
    EXPECT compared.gt = 0
  END
  CASE "the top bit decides"
    INPUT a = 1000
    INPUT b = 0111
    EXPECT compared.eq = 0
    EXPECT compared.lt = 0
    EXPECT compared.gt = 1
  END
  CASE "the bottom bit breaks a tie"
    INPUT a = 0101
    INPUT b = 0100
    EXPECT compared.eq = 0
    EXPECT compared.lt = 0
    EXPECT compared.gt = 1
  END
  CASE "smaller"
    INPUT a = 0011
    INPUT b = 1010
    EXPECT compared.eq = 0
    EXPECT compared.lt = 1
    EXPECT compared.gt = 0
  END
  CASE "the smallest pair"
    INPUT a = 0000
    INPUT b = 0000
    EXPECT compared.eq = 1
    EXPECT compared.lt = 0
    EXPECT compared.gt = 0
  END
  CASE "the largest pair"
    INPUT a = 1111
    INPUT b = 1111
    EXPECT compared.eq = 1
    EXPECT compared.lt = 0
    EXPECT compared.gt = 0
  END
END
