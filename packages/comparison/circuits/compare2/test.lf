CIRCUIT COMPARE2_TEST
  INPUT a : BUS(2)
  INPUT b : BUS(2)

  compared = COMPARE2(a, b)

  OUTPUT compared.eq
  OUTPUT compared.lt
  OUTPUT compared.gt
END

TEST COMPARE2_TEST
  CASE "equal values"
    INPUT a = 10
    INPUT b = 10
    EXPECT compared.eq = 1
    EXPECT compared.lt = 0
    EXPECT compared.gt = 0
  END
  CASE "the high bit decides"
    INPUT a = 10
    INPUT b = 01
    EXPECT compared.eq = 0
    EXPECT compared.lt = 0
    EXPECT compared.gt = 1
  END
  CASE "the low bit breaks a tie"
    INPUT a = 01
    INPUT b = 00
    EXPECT compared.eq = 0
    EXPECT compared.lt = 0
    EXPECT compared.gt = 1
  END
  CASE "smaller"
    INPUT a = 01
    INPUT b = 10
    EXPECT compared.eq = 0
    EXPECT compared.lt = 1
    EXPECT compared.gt = 0
  END
  CASE "the smallest pair"
    INPUT a = 00
    INPUT b = 00
    EXPECT compared.eq = 1
    EXPECT compared.lt = 0
    EXPECT compared.gt = 0
  END
  CASE "the largest pair"
    INPUT a = 11
    INPUT b = 11
    EXPECT compared.eq = 1
    EXPECT compared.lt = 0
    EXPECT compared.gt = 0
  END
END
