{
  "schema": "shortcircuit.package/v1",
  "name": "@shortcircuit/comparison",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "recommendedAutoImport": true,
  "description": "Unsigned magnitude comparators built from the gates package.",
  "dependencies": {
    "@shortcircuit/gates": "^0.1.0"
  },
  "tests": "tests/comparison.test.lf",
  "exports": [
    {
      "kind": "circuit",
      "name": "COMPARE1",
      "group": "Comparison Circuits",
      "summary": "One-bit comparator. Sets exactly one of eq, lt or gt.",
      "source": "circuits/compare1/circuit.lf",
      "docs": "circuits/compare1/docs.md",
      "tests": "circuits/compare1/test.lf",
      "examples": [
        "compared = COMPARE1(a, b)"
      ],
      "ports": {
        "inputs": [
          { "name": "a", "width": 1 },
          { "name": "b", "width": 1 }
        ],
        "outputs": [
          { "name": "eq", "width": 1 },
          { "name": "lt", "width": 1 },
          { "name": "gt", "width": 1 }
        ]
      }
    },
    {
