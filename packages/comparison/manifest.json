        "compared = COMPARE2(a, b)"
      ],
      "ports": {
        "inputs": [
          { "name": "a", "width": 2 },
          { "name": "b", "width": 2 }
        ],
        "outputs": [
          { "name": "eq", "width": 1 },
          { "name": "lt", "width": 1 },
          { "name": "gt", "width": 1 }
        ]
      }
    },
    {
      "kind": "circuit",
      "name": "COMPARE4",
